# Jira
JIRA_BASE_URL=https://seu-dominio.atlassian.net
JIRA_EMAIL=seu-email@empresa.com
JIRA_API_TOKEN=seu-token-jira

# AI Providers
OPENAI_API_KEY=sua-chave-openai
GEMINI_API_KEY=sua-chave-gemini

# CORS (Fase 13.1B) — origens de browser autorizadas a acessar a API.
# Obrigatória para acesso via frontend (Angular); sem esta variável o CORS
# fica fail-closed (nenhuma origem cross-origin autorizada). Múltiplas
# origens separadas por vírgula. Não é segredo — apenas configuração.
# Desenvolvimento local: http://localhost:4200
# Produção: origem real de onde o frontend é servido
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200


