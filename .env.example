# Jira
JIRA_BASE_URL=https://seu-dominio.atlassian.net
JIRA_EMAIL=seu-email@empresa.com
JIRA_API_TOKEN=seu-token-jira

# AI Providers
# Escolha qual provider atende as requisições (openai | gemini | claude).
AI_ACTIVE_PROVIDER=claude
AI_FALLBACK_PROVIDER=openai

OPENAI_API_KEY=sua-chave-openai
GEMINI_API_KEY=sua-chave-gemini

# Claude (Anthropic). Token gerado em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sua-chave-anthropic
# Opcionais — os defaults já são adequados para geração de cenários.
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=medium
# CLAUDE_MAX_TOKENS=16000

# Zephyr Scale Cloud — publica cada cenário gerado como caso de teste real.
# Desabilitado por padrão (ZEPHYR_ENABLED=false); ligue só quando as demais
# variáveis abaixo estiverem preenchidas. O token é gerado em
# Zephyr Scale > API Access Tokens (é diferente do token de API do Jira).
ZEPHYR_ENABLED=false
ZEPHYR_API_TOKEN=seu-token-zephyr-scale
ZEPHYR_PROJECT_KEY=SCRUM
ZEPHYR_BASE_URL=https://api.zephyrscale.smartbear.com/v2
ZEPHYR_DEFAULT_STATUS=Draft
ZEPHYR_DEFAULT_PRIORITY=Normal

# CORS (Fase 13.1B) — origens de browser autorizadas a acessar a API.
# Obrigatória para acesso via frontend (Angular); sem esta variável o CORS
# fica fail-closed (nenhuma origem cross-origin autorizada). Múltiplas
# origens separadas por vírgula. Não é segredo — apenas configuração.
# Desenvolvimento local: http://localhost:4200
# Produção: origem real de onde o frontend é servido
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200


